# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN LOCAL - gestionasistenciadb
# Copie este archivo como '.env' en la raíz del proyecto y ajuste sus credenciales.
# NOTA: El archivo '.env' está ignorado en Git (.gitignore) y nunca se subirá.
# ==============================================================================

# Nombre del contenedor Docker de SQL Server local
SQL_CONTAINER_NAME=sql_server_asistencias

# Contraseña del usuario 'sa' para el contenedor Docker local.
# Reemplace CHANGE_ME por una contraseña propia en su '.env' local (ignorado por Git). NUNCA la versione aquí.
SQL_CONTAINER_PASSWORD=CHANGE_ME
